43:HERE = os.path.dirname(os.path.abspath(__file__))
44:STATE = os.path.join(HERE, "state.json")
45:HUMAN = os.path.join(HERE, "STATE.md")
46:LOG = os.path.join(HERE, "watchdog.log")
47:EVAL = os.path.join(HERE, "eval_runner.py")
48:EVAL_LOCK = os.path.join(HERE, "eval_runner.lock")
