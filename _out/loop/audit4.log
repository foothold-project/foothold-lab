42:REPO = os.path.abspath(os.path.join(HERE, "..", ".."))
43:STATE = os.path.join(HERE, "state.json")
44:LOG = os.path.join(HERE, "eval_runner.log")
45:LOCK = os.path.join(HERE, "eval_runner.lock")
