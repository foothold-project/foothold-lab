155:def axis2_one_checkpoint(vm, tag: str) -> dict:
156:    """한 체크포인트의 축 2 아홉 칸. **칸마다 표본 보유 env 수를 병기한다.**"""
157:    path = os.path.join(REPO, AXIS2_ROOT, tag, "probe_manifest.json")
158:    if not os.path.isfile(path):
159:        return {"error": "probe_manifest.json 이 없다", "passed": None}
160:    with io.open(path, encoding="utf-8") as h:
161:        man = json.load(h)
162:
163:    summary = man.get("summary") or {}
164:    cells = []
165:
166:    for (scen, metric), (op, limit) in sorted(vm.AXIS2_THRESHOLDS.items()):
167:        block = summary.get(scen) or {}
168:        value = block.get(metric)
169:        cells.append({
170:            "key": "%s/%s" % (scen, metric),
171:            "value": None if value is None else round(value, 6),
172:            "threshold": "%s %s" % (op, limit),
173:            "passed": None if value is None else (value <= limit),
174:            "n_envs": sample_count(tag, scen),
175:        })
176:
177:    for scen, block in sorted(summary.items()):
178:        for wz, ratio in sorted((block.get("yaw_follow_ratio") or {}).items()):
179:            cells.append({
180:                "key": "%s/yaw_follow/%s" % (scen, wz),
181:                "value": None if ratio is None else round(ratio, 6),
182:                "threshold": ">= %s" % vm.YAW_RATIO_MIN,
183:                "passed": None if ratio is None else (ratio >= vm.YAW_RATIO_MIN),
184:                "n_envs": sample_count(tag, scen, wz),
185:            })
186:
187:    passed = sum(1 for c in cells if c["passed"] is True)
188:    return {
189:        "cells": cells,
190:        "passed": passed,
191:        "total": vm.AXIS2_TOTAL_CELLS,
192:        "gate": vm.AXIS2_GATE_CELLS,
193:        "met": passed >= vm.AXIS2_GATE_CELLS,
194:        "counted": len(cells),
195:        "count_warning": (None if len(cells) == vm.AXIS2_TOTAL_CELLS else
196:                          "칸이 %d 개다. 기대한 %d 개가 아니다. 판정에 쓰기 전에 사람이 본다"
197:                          % (len(cells), vm.AXIS2_TOTAL_CELLS)),
198:    }
