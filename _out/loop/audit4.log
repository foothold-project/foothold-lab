79:
80:def training_done(run: dict) -> tuple[bool, str]:
81:    """(끝났나, 까닭). **파일 하나만 보고 끝났다고 하지 않는다.**
82:
83:    프로세스가 살아 있는데 마지막 체크포인트가 있을 수도 있고(저장 직후),
84:    프로세스가 죽었는데 체크포인트가 없을 수도 있다(중간에 터짐).
85:    둘을 다 본다.
86:    """
87:    d = run_dir(run)
88:    if d is None:
89:        return (False, "실행 폴더를 못 찾는다")
90:    last = os.path.join(d, "model_%d.pt" % CKPTS[-1])
91:    if not os.path.isfile(last):
92:        return (False, "model_%d.pt 가 없다" % CKPTS[-1])
93:    if pid_alive(run.get("pid")):
94:        return (False, "PID %s 가 아직 살아 있다" % run.get("pid"))
95:    missing = [c for c in CKPTS
96:               if not os.path.isfile(os.path.join(d, "model_%d.pt" % c))]
97:    if missing:
98:        return (False, "체크포인트가 빈다: %s" % missing)
99:    return (True, "체크포인트 넷이 있고 프로세스가 끝났다")
100:
101:
102:def pid_alive(pid) -> bool:
103:    if not pid:
104:        return False
105:    try:
106:        out = subprocess.run(
107:            ["powershell", "-NoProfile", "-Command",
108:             "if (Get-Process -Id %d -ErrorAction SilentlyContinue) "
109:             "{ 'yes' } else { 'no' }" % int(pid)],
110:            capture_output=True, text=True, timeout=30).stdout
111:        return "yes" in out
112:    except Exception as exc:                                   # noqa: BLE001
113:        log("PID 확인 실패 · 살아 있다고 «보수적으로» 본다: %s" % exc)
114:        return True
115:
116:
117:def run_dir(run: dict):
118:    pat = run.get("out_dir") or ""
119:    base, tail = os.path.split(pat)
120:    if "*" not in tail or not os.path.isdir(base):
121:        return base if os.path.isdir(base) else None
122:    suffix = tail.lstrip("*")
123:    hits = sorted(n for n in os.listdir(base) if n.endswith(suffix))
124:    return os.path.join(base, hits[-1]) if hits else None
125:
126:
127:# --------------------------------------------------------------------------
128:# 할 일 목록
129:
130:
131:def jobs_for(run: dict) -> list[dict]:
132:    d = run_dir(run)
133:    name = run["name"]
134:    out = []
135:    for c in CKPTS:
136:        ckpt = os.path.join(d, "model_%d.pt" % c).replace("\\", "/")
137:        tag = "%s-iter%d" % (name, c)
138:        for ts in AXIS1_SETS:
139:            for vx, dur in AXIS1_SPEEDS:
140:                odir = "%s/%s/%s/d0.5/v%s" % (OUT_AXIS1, tag, ts, vx)
141:                out.append({
142:                    "axis": 1, "tag": tag, "device": AXIS1_DEVICE, "out": odir,
143:                    "argv": ["sim/eval/eval_generalization.py",
144:                             "--checkpoint", ckpt,
145:                             "--terrain_set", ts, "--terrains", "all",
146:                             "--difficulty", "0.5",
147:                             "--episodes", "100", "--envs_per_terrain", "10",
148:                             "--command_vx", vx, "--eval_duration", dur,
149:                             "--min_progress_m", "3.0",
150:                             "--max_lateral_drift", "0.75",
151:                             "--seed", "42", "--headless",
152:                             "--device", AXIS1_DEVICE,
153:                             "--output_dir", odir],
154:                    "done_marker": odir + "/generalization_summary.csv",
155:                })
156:        odir2 = "%s/%s" % (OUT_AXIS2, tag)
157:        out.append({
158:            "axis": 2, "tag": tag, "device": AXIS2_DEVICE, "out": odir2,
159:            "argv": ["sim/eval/eval_command_response.py",
160:                     "--checkpoint", ckpt,
161:                     "--label", tag,
162:                     "--scenario", "all",
163:                     "--num_envs", "64",
164:                     "--seed", "42",
165:                     "--output_dir", odir2],
166:            "done_marker": odir2 + "/probe_manifest.json",
167:        })
168:    return out
169:
170:
171:# --------------------------------------------------------------------------
172:# 한 건 실행
173:
174:
175:def run_job(job: dict) -> int:
176:    odir = os.path.join(REPO, job["out"].replace("/", os.sep))
177:    os.makedirs(odir, exist_ok=True)
178:
179:    argv = [PYTHON] + job["argv"]
180:    # 규칙 7 · 실행 명령을 결과 폴더에 «파일로» 남긴다.
181:    # 무엇으로 돌렸는지가 사람 기억에만 있으면 재현을 못 한다.
182:    with io.open(os.path.join(odir, "command.txt"), "w", encoding="utf-8") as h:
183:        h.write(" ".join('"%s"' % a if " " in a else a for a in argv) + "\n")
184:        h.write("# 걸린 때 %s\n" % dt.datetime.now().isoformat(timespec="seconds"))
185:        h.write("# 건 것 _out/loop/eval_runner.py\n")
186:
187:    env = dict(os.environ)
188:    env["OMNI_KIT_ACCEPT_EULA"] = "YES"
189:    logfile = os.path.join(odir, "run.log")
190:    started = dt.datetime.now()
191:    with io.open(logfile, "w", encoding="utf-8", errors="replace") as h:
192:        proc = subprocess.Popen(argv, cwd=REPO, env=env,
193:                                stdout=h, stderr=subprocess.STDOUT)
194:        code = proc.wait()
195:    mins = (dt.datetime.now() - started).total_seconds() / 60
196:    ok = code == 0 and os.path.isfile(os.path.join(REPO, job["done_marker"]))
197:    log("  %s 축%d %s · %.1f 분 · exit=%d · %s"
198:        % (job["tag"], job["axis"], job["device"], mins, code,
199:           "산출물 있음" if ok else "«산출물 없음»"))
200:    return 0 if ok else 1
201:
202:
203:def worker(device: str, queue: list, results: dict) -> None:
204:    for job in queue:
205:        results[job["out"]] = run_job(job)
206:
207:
208:# --------------------------------------------------------------------------
209:
210:
211:def take_lock() -> bool:
212:    """두 번 도는 것을 막는다. 감시 스크립트가 10 분마다 깨우기 때문이다."""
213:    if os.path.isfile(LOCK):
214:        try:
215:            with io.open(LOCK, encoding="utf-8") as h:
216:                old = int((h.read().split() or ["0"])[0])
217:        except Exception:                                      # noqa: BLE001
218:            old = 0
219:        if old and pid_alive(old):
220:            log("이미 %d 번이 돌고 있다. 나온다" % old)
221:            return False
222:        log("죽은 잠금을 치운다 (PID %s)" % old)
223:    with io.open(LOCK, "w", encoding="utf-8") as h:
224:        h.write("%d %s\n" % (os.getpid(), dt.datetime.now().isoformat()))
225:    return True
226:
227:
228:def drop_lock() -> None:
229:    try:
230:        os.remove(LOCK)
231:    except OSError:
232:        pass
233:
234:
235:def main() -> int:
236:    ap = argparse.ArgumentParser()
237:    ap.add_argument("--dry-run", action="store_true",
238:                    help="무엇을 돌릴지만 적고 «아무것도 안 건다»")
239:    ap.add_argument("--force", action="store_true",
240:                    help="이미 산출물이 있어도 다시 돈다")
241:    ap.add_argument("--state", default=STATE,
242:                    help="다른 상태 파일로 시험할 때만 쓴다")
243:    args = ap.parse_args()
244:
245:    with io.open(args.state, encoding="utf-8") as h:
246:        state = json.load(h)
247:
248:    ready, waiting = [], []
249:    for run in state.get("running") or []:
250:        ok, why = training_done(run)
251:        (ready if ok else waiting).append((run, why))
252:
253:    for run, why in waiting:
254:        log("%s 아직 · %s" % (run["name"], why))
255:    if not ready:
256:        log("평가할 것이 없다")
257:        return 0
258:
259:    todo = []
260:    for run, why in ready:
261:        log("%s 준비됨 · %s" % (run["name"], why))
262:        for job in jobs_for(run):
263:            if not args.force and os.path.isfile(
264:                    os.path.join(REPO, job["done_marker"])):
265:                log("  건너뜀 (이미 있음) %s" % job["out"])
266:                continue
267:            todo.append(job)
268:
269:    log("걸 것 %d 건 · 축1 %d · 축2 %d"
270:        % (len(todo), sum(1 for j in todo if j["axis"] == 1),
271:           sum(1 for j in todo if j["axis"] == 2)))
272:
273:    if args.dry_run:
274:        for j in todo[:4]:
275:            log("  [예시] %s" % " ".join(j["argv"]))
276:        log("«--dry-run 이라 아무것도 안 걸었다»")
277:        return 0
278:
279:    if not todo:
280:        return 0
281:    if not take_lock():
282:        return 0
283:    try:
284:        queues = {AXIS1_DEVICE: [j for j in todo if j["device"] == AXIS1_DEVICE],
285:                  AXIS2_DEVICE: [j for j in todo if j["device"] == AXIS2_DEVICE]}
286:        results: dict = {}
287:        threads = [threading.Thread(target=worker, args=(d, q, results))
288:                   for d, q in queues.items() if q]
289:        for t in threads:
290:            t.start()
291:        for t in threads:
292:            t.join()
293:        bad = [k for k, v in results.items() if v != 0]
294:        log("끝 · %d 건 중 실패 %d" % (len(results), len(bad)))
295:        for k in bad:
296:            log("  실패 · %s" % k)
297:        return 1 if bad else 0
298:    finally:
299:        drop_lock()
300:
301:
302:if __name__ == "__main__":
303:    sys.exit(main())
