72:def read_big_python() -> list[tuple[int, float]]:
73:    """메모리가 큰 python 프로세스. (pid, GB) 목록."""
74:    rows = []
75:    try:
76:        out = subprocess.run(
77:            ["powershell", "-NoProfile", "-Command",
78:             "Get-Process python -ErrorAction SilentlyContinue | "
79:             "ForEach-Object { \"$($_.Id) $($_.WorkingSet64)\" }"],
80:            capture_output=True, text=True, timeout=30).stdout
81:        for ln in out.splitlines():
82:            parts = ln.split()
83:            if len(parts) != 2:
84:                continue
85:            pid, ws = int(parts[0]), int(parts[1])
86:            if ws >= TRAIN_MIN_BYTES:
87:                rows.append((pid, ws / 1024 ** 3))
88:    except Exception as exc:                                  # noqa: BLE001
89:        log("프로세스 조회 실패: %s" % exc)
90:    return rows
