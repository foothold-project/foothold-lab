165:def find_mismatch(state: dict, big: list) -> list[str]:
166:    """상태 파일이 실제와 어긋나는 곳. **고치지 않고 적기만 한다.**"""
167:    out = []
168:    declared = state.get("running") or []
169:
170:    # **PID 마다 따로 본다.** 2026-09-23 에 여기서 한 번 놓쳤다.
171:    # 예전 판은 「선언은 있는데 큰 python 이 «하나도» 없다」만 봤다.
172:    # 둘을 걸고 하나가 죽으면 나머지 하나가 남아서 그물을 빠져나갔다.
173:    # 실제로 v2b-s 가 죽고 18 분을 조용히 지나갔다.
174:    live = set(p for p, _ in big)
175:    for run in declared:
176:        pid = run.get("pid")
177:        if pid and int(pid) not in live:
178:            out.append("«%s» (PID %s) 이 «죽었다». 자동으로 다시 걸지 «않는다». "
179:                       "로그를 보고 사람이 정한다: %s"
180:                       % (run.get("name"), pid, run.get("log") or "로그 경로 없음"))
181:
182:    if declared and not big:
