50:# 학습으로 볼 프로세스의 최소 메모리. v2a/v2b 가 6.3 ~ 6.4 GB 였다.
51:TRAIN_MIN_BYTES = 1 * 1024 ** 3
52:
53:
54:def log(msg: str) -> None:
55:    line = "%s  %s\n" % (dt.datetime.now().strftime("%Y-%m-%d %H:%M:%S"), msg)
56:    with io.open(LOG, "a", encoding="utf-8") as handle:
57:        handle.write(line)
