60:def read_gpu() -> list[str]:
61:    """`nvidia-smi` 한 줄씩. 못 부르면 그 사실을 문자열로 남긴다."""
62:    try:
63:        out = subprocess.run(
64:            ["nvidia-smi", "--query-gpu=index,utilization.gpu,memory.used",
65:             "--format=csv,noheader"],
66:            capture_output=True, text=True, timeout=20, check=True).stdout
67:        return [ln.strip() for ln in out.splitlines() if ln.strip()]
68:    except Exception as exc:                                  # noqa: BLE001
69:        return ["nvidia-smi 실패: %s" % exc]
