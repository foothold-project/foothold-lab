115:def launch_eval() -> str:
116:    """평가를 떼어 놓고 띄운다. **학습은 절대 안 띄운다.**
117:
118:    걸 것이 있는지는 `eval_runner.py` 가 스스로 판단한다. 여기서 또
119:    판단하면 같은 규칙이 두 곳에 생기고 반드시 갈라진다.
120:    """
121:    if eval_running():
122:        return "평가가 이미 돌고 있다"
123:    try:
124:        subprocess.Popen(
125:            [sys.executable, EVAL],
126:            cwd=os.path.abspath(os.path.join(HERE, "..", "..")),
127:            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
128:            creationflags=getattr(subprocess, "DETACHED_PROCESS", 0))
129:        return "평가를 띄웠다"
130:    except Exception as exc:                                  # noqa: BLE001
131:        return "평가를 못 띄웠다: %s" % exc
