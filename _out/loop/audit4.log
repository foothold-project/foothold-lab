211:def take_lock() -> bool:
212:    """두 번 도는 것을 막는다. 감시 스크립트가 10 분마다 깨우기 때문이다."""
213:    if os.path.isfile(LOCK):
214:        try:
215:            with io.open(LOCK, encoding="utf-8") as h:
216:                old = int((h.read().split() or ["0"])[0])
217:        except Exception:                                      # noqa: BLE001
218:            old = 0
219:        if old and pid_alive(old):
220:            log("이미 %d 번이 돌고 있다. 나온다" % old)
221:            return False
222:        log("죽은 잠금을 치운다 (PID %s)" % old)
223:    with io.open(LOCK, "w", encoding="utf-8") as h:
224:        h.write("%d %s\n" % (os.getpid(), dt.datetime.now().isoformat()))
225:    return True
226:
227:
228:def drop_lock() -> None:
229:    try:
230:        os.remove(LOCK)
231:    except OSError:
232:        pass
233:
234:
235:def main() -> int:
236:    ap = argparse.ArgumentParser()
237:    ap.add_argument("--dry-run", action="store_true",
238:                    help="무엇을 돌릴지만 적고 «아무것도 안 건다»")
239:    ap.add_argument("--force", action="store_true",
240:                    help="이미 산출물이 있어도 다시 돈다")
241:    ap.add_argument("--state", default=STATE,
242:                    help="다른 상태 파일로 시험할 때만 쓴다")
243:    args = ap.parse_args()
244:
245:    with io.open(args.state, encoding="utf-8") as h:
246:        state = json.load(h)
247:
248:    ready, waiting = [], []
249:    for run in state.get("running") or []:
250:        ok, why = training_done(run)
251:        (ready if ok else waiting).append((run, why))
252:
253:    for run, why in waiting:
254:        log("%s 아직 · %s" % (run["name"], why))
255:    if not ready:
256:        log("평가할 것이 없다")
257:        return 0
258:
259:    todo = []
260:    for run, why in ready:
261:        log("%s 준비됨 · %s" % (run["name"], why))
262:        for job in jobs_for(run):
263:            if not args.force and os.path.isfile(
264:                    os.path.join(REPO, job["done_marker"])):
265:                log("  건너뜀 (이미 있음) %s" % job["out"])
266:                continue
267:            todo.append(job)
268:
269:    log("걸 것 %d 건 · 축1 %d · 축2 %d"
270:        % (len(todo), sum(1 for j in todo if j["axis"] == 1),
271:           sum(1 for j in todo if j["axis"] == 2)))
272:
273:    if args.dry_run:
274:        for j in todo[:4]:
275:            log("  [예시] %s" % " ".join(j["argv"]))
276:        log("«--dry-run 이라 아무것도 안 걸었다»")
277:        return 0
278:
279:    if not todo:
280:        return 0
281:    if not take_lock():
282:        return 0
283:    try:
284:        queues = {AXIS1_DEVICE: [j for j in todo if j["device"] == AXIS1_DEVICE],
285:                  AXIS2_DEVICE: [j for j in todo if j["device"] == AXIS2_DEVICE]}
286:        results: dict = {}
287:        threads = [threading.Thread(target=worker, args=(d, q, results))
288:                   for d, q in queues.items() if q]
289:        for t in threads:
290:            t.start()
291:        for t in threads:
292:            t.join()
293:        bad = [k for k, v in results.items() if v != 0]
294:        log("끝 · %d 건 중 실패 %d" % (len(results), len(bad)))
295:        for k in bad:
296:            log("  실패 · %s" % k)
297:        return 1 if bad else 0
298:    finally:
299:        drop_lock()
300:
301:
302:if __name__ == "__main__":
303:    sys.exit(main())
