201:def sample_count(tag: str, scenario: str, wz=None):
202:    """그 칸에 «표본이 있는» env 수. 없으면 None.
203:
204:    감사 지적 2-9 · `F` 의 `0.4195` 는 64 대가 아니라 51 대의 성적이었다.
205:    앞 구간에서 넘어진 개체는 뒤 구간에 표본이 없다. 비율만 적으면
206:    그 사실이 사라진다.
207:    """
208:    p = os.path.join(REPO, AXIS2_ROOT, tag, scenario, "per_env.json")
209:    if not os.path.isfile(p):
210:        return None
211:    try:
212:        with io.open(p, encoding="utf-8") as h:
213:            rows = json.load(h)
214:    except Exception:                                          # noqa: BLE001
215:        return None
216:    if not isinstance(rows, list):
217:        rows = rows.get("envs") or []
218:    if wz is None:
219:        return len(rows)
220:    n = 0
221:    for r in rows:
222:        blk = (r or {}).get("yaw_follow") or {}
223:        if blk.get(wz) is not None or blk.get(str(wz)) is not None:
224:            n += 1
225:    return n
