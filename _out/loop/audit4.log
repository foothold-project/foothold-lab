93:def eval_running() -> bool:
94:    """평가가 이미 돌고 있나. 잠금 파일의 PID 로 본다."""
95:    if not os.path.isfile(EVAL_LOCK):
96:        return False
97:    try:
98:        with io.open(EVAL_LOCK, encoding="utf-8") as handle:
99:            pid = int((handle.read().split() or ["0"])[0])
100:    except Exception:                                         # noqa: BLE001
101:        return False
102:    if not pid:
103:        return False
104:    try:
105:        out = subprocess.run(
106:            ["powershell", "-NoProfile", "-Command",
107:             "if (Get-Process -Id %d -ErrorAction SilentlyContinue) "
108:             "{ 'yes' } else { 'no' }" % pid],
109:            capture_output=True, text=True, timeout=30).stdout
110:        return "yes" in out
111:    except Exception:                                         # noqa: BLE001
112:        return True      # 모르면 «돌고 있다» 로 본다. 두 번 거는 것보다 낫다
