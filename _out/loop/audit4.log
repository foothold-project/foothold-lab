1:# -*- coding: utf-8 -*-
2:"""채점 · 평가 산출물에서 판정 숫자를 낸다.
3:
4:분류: 운영
5:작성: 오흥재 · 2026-09-23
6:근거: `inbox/jay/20260923-lineage/CRITERIA.md` v1.4 (1 절 · 3-0 절 · 3-0-1 절) ·
7:      `sim/eval/verdict_manifest.py` 의 판단 원시함수 · `models/foothold-v1.json`
8:요지: 한 판의 체크포인트 넷을 두 축으로 채점하고, 보고 강제 항목을 «전부» 채운
9:      판정 파일을 낸다. **판단 규칙을 여기에 다시 구현하지 않는다.**
10:상태: 초안
11:판: v1.0
12:
13:왜 판단 규칙을 여기 안 쓰는가
14:    Wilson 비교와 축 2 문턱은 `sim/eval/verdict_manifest.py` 에 이미 있고
15:    그쪽이 정본이다. 여기에 한 벌 더 쓰면 두 곳이 반드시 갈라진다.
16:    2026-09-23 감사가 「구현을 복제한 시험」을 지적한 것과 같은 까닭이다.
17:    그래서 «상수와 순수 함수만» 가져온다.
18:
19:왜 axis1_entries / axis2_entries 는 «안» 쓰는가
20:    그 둘은 정책 이름이 박힌 목록(`AXIS2_POLICIES`)과 갤러리 영상 찾기에
21:    묶여 있다. 새 정책(`v2b-r` 등)이 그 목록에 없다. 보고서를 만드는
22:    함수이지 판단 함수가 아니다. 판단에 필요한 것만 가져온다.
23:
24:돌리는 법
25:    python _out/loop/verdict.py --run v2b-r
26:    python _out/loop/verdict.py --run v2b-r --eval-dir <다른 sim/eval>
27:"""
28:
29:from __future__ import annotations
30:
31:import argparse
32:import datetime as dt
33:import io
34:import json
35:import os
36:import sys
37:
38:HERE = os.path.dirname(os.path.abspath(__file__))
39:REPO = os.path.abspath(os.path.join(HERE, "..", ".."))
40:
41:CKPTS = (1500, 2000, 2500, 3000)
42:SPEEDS = ("v0.5", "v1.0", "v1.5")
43:SPEED_VX = {"v0.5": 0.5, "v1.0": 1.0, "v1.5": 1.5}
44:SETS = ("rough6", "unseen10")
45:
46:AXIS1_ROOT = "sim/eval/results/20260923-v2rs"
47:AXIS2_ROOT = "sim/eval/results/20260923-v2rs-axis2"
48:NVIDIA_ROOT = "sim/eval/results/20260921-nvidia-axis1"
49:V1_CARD = "models/foothold-v1.json"
50:
51:
52:def load_rules(eval_dir: str):
53:    """`verdict_manifest.py` 에서 «판단에 쓰는 것만» 가져온다."""
54:    if eval_dir not in sys.path:
55:        sys.path.insert(0, eval_dir)
56:    try:
57:        import verdict_manifest as vm            # noqa: PLC0415
58:    except ImportError as exc:
59:        raise SystemExit(
60:            "판단 규칙을 못 읽었다: %s\n"
61:            "  `sim/eval/verdict_manifest.py` 가 필요하다.\n"
62:            "  지금은 PR #444 (feature/command-restore-jay) 에만 있다.\n"
63:            "  다른 곳을 보려면 --eval-dir 로 준다.\n"
64:            "  **여기에 규칙을 다시 구현하지 않는다.** 두 곳이 갈라진다."
65:            % exc)
66:    need = ("read_summary", "compare_wilson", "wilson_pct",
67:            "AXIS2_THRESHOLDS", "YAW_RATIO_MIN",
68:            "AXIS2_GATE_CELLS", "AXIS2_TOTAL_CELLS", "V1_SPEED_DIRS")
69:    missing = [n for n in need if not hasattr(vm, n)]
70:    if missing:
71:        raise SystemExit("`verdict_manifest.py` 에 %s 가 없다. 판이 다르다" % missing)
72:    return vm
73:
74:
75:# --------------------------------------------------------------------------
76:# 축 1
77:
78:
79:def axis1_one_checkpoint(vm, tag: str, v1_scores: dict) -> dict:
80:    """한 체크포인트의 축 1. **CRITERIA 3-0 이 요구하는 것을 다 채운다.**"""
81:    cells, zero_cells = [], []
82:    drop_v1 = rise_v1 = undecided_v1 = 0
83:    drop_nv = rise_nv = undecided_nv = 0
84:    worst = None
85:
86:    for ts in SETS:
87:        for sp in SPEEDS:
88:            vx = SPEED_VX[sp]
89:            here = vm.read_summary(os.path.join(
90:                REPO, AXIS1_ROOT, tag, ts, "d0.5", sp,
91:                "generalization_summary.csv"))
92:            if not here:
93:                continue
94:
95:            # foothold-v1 · 정본은 모델 카드의 «칸 값» 이다 (100 판 기준).
96:            ref_v1 = (v1_scores.get("%s m/s" % vx) or {}).get(ts) or {}
97:            # NVIDIA · 원시 csv 에서 읽는다.
98:            ref_nv = vm.read_summary(os.path.join(
99:                REPO, NVIDIA_ROOT, ts, "d0.5", sp,
100:                "generalization_summary.csv"))
101:
102:            for terrain, cell in sorted(here.items()):
103:                pct, succ, n = cell
104:                low, high = vm.wilson_pct(succ, n)
105:
106:                base = ref_v1.get(terrain)
107:                v1_cell = None if base is None else (base, round(base), 100)
108:                ok_v1, why_v1 = vm.compare_wilson(v1_cell, cell)
109:                if ok_v1 is True:
110:                    rise_v1 += 1
111:                elif ok_v1 is False:
112:                    drop_v1 += 1
113:                else:
114:                    undecided_v1 += 1
115:
116:                ok_nv, why_nv = vm.compare_wilson(ref_nv.get(terrain), cell)
117:                if ok_nv is True:
118:                    rise_nv += 1
119:                elif ok_nv is False:
120:                    drop_nv += 1
121:                else:
122:                    undecided_nv += 1
123:
124:                if pct == 0.0:
125:                    zero_cells.append("%s %.1f" % (terrain, vx))
126:                if worst is None or pct < worst[0]:
127:                    worst = (pct, terrain, vx)
128:
129:                cells.append({
130:                    "terrain_set": ts, "terrain": terrain, "vx": vx,
131:                    "pct": round(pct, 2), "successes": succ, "episodes": n,
132:                    "wilson": [low, high],
133:                    "vs_v1": ok_v1, "vs_v1_why": why_v1,
134:                    "vs_nvidia": ok_nv, "vs_nvidia_why": why_nv,
135:                })
136:
137:    return {
138:        "cells_measured": len(cells),
139:        "vs_foothold_v1": {"drop": drop_v1, "rise": rise_v1,
140:                           "undecided": undecided_v1},
141:        "vs_nvidia": {"drop": drop_nv, "rise": rise_nv,
142:                      "undecided": undecided_nv} if ref_nv else None,
143:        # 3-0-1 · 체크포인트마다 «하나». 네 값을 평균 내지 않는다.
144:        "absolute_min_cell": None if worst is None else {
145:            "pct": round(worst[0], 2), "terrain": worst[1], "vx": worst[2]},
146:        "zero_cells": sorted(zero_cells),
147:        "cells": cells,
148:    }
