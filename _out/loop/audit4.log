231:def verdict(vm, run: str) -> dict:
232:    with io.open(os.path.join(REPO, V1_CARD), encoding="utf-8") as h:
233:        v1_scores = json.load(h)["scores_difficulty_0_5"]
234:
235:    per_ckpt = {}
236:    for c in CKPTS:
237:        tag = "%s-iter%d" % (run, c)
238:        per_ckpt[str(c)] = {
239:            "tag": tag,
240:            "axis1": axis1_one_checkpoint(vm, tag, v1_scores),
241:            "axis2": axis2_one_checkpoint(vm, tag),
242:        }
243:
244:    drops = [per_ckpt[str(c)]["axis1"]["vs_foothold_v1"]["drop"] for c in CKPTS]
245:    a2 = [per_ckpt[str(c)]["axis2"].get("passed") for c in CKPTS]
246:    mins = [(per_ckpt[str(c)]["axis1"]["absolute_min_cell"] or {}).get("pct")
247:            for c in CKPTS]
248:
249:    axis1_met = all(d == 0 for d in drops)
250:    axis2_met = all(p == vm.AXIS2_GATE_CELLS for p in a2 if p is not None) \
251:        and None not in a2
252:
253:    return {
254:        "run": run,
255:        "criteria": "CRITERIA.md v1.4 · 1 절",
256:        "made_at": dt.datetime.now().isoformat(timespec="seconds"),
257:        "made_by": "_out/loop/verdict.py",
258:        "checkpoints": per_ckpt,
259:        "axis1_drops": drops,
260:        "axis2_passed": a2,
261:        "absolute_min_cells": mins,      # 3-0-1 · 네 값. 평균 내지 않는다
262:        "axis1_met": axis1_met,
263:        "axis2_met": axis2_met,
264:        "candidate": bool(axis1_met and axis2_met),
265:        "note": "재현은 이 파일이 판정하지 않는다. 별도 판이다 (CRITERIA 1 절)",
266:    }
