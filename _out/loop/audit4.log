102:def pid_alive(pid) -> bool:
103:    if not pid:
104:        return False
105:    try:
106:        out = subprocess.run(
107:            ["powershell", "-NoProfile", "-Command",
108:             "if (Get-Process -Id %d -ErrorAction SilentlyContinue) "
109:             "{ 'yes' } else { 'no' }" % int(pid)],
110:            capture_output=True, text=True, timeout=30).stdout
111:        return "yes" in out
112:    except Exception as exc:                                   # noqa: BLE001
113:        log("PID 확인 실패 · 살아 있다고 «보수적으로» 본다: %s" % exc)
114:        return True
