222:    docs = state.get("docs") or {}
223:    declared = state.get("running") or []
224:
225:    if declared:
226:        running = "\n          ".join(
227:            "%s  GPU %s  PID %s  시작 %s"
228:            % (r.get("name"), r.get("gpu"), r.get("pid"), r.get("started"))
229:            for r in declared)
230:    else:
231:        running = "없음"
232:
233:    mm = "없음" if not mismatch else "\n".join("- " + m for m in mismatch)
234:
235:    return """# 루프 상태 · 사람이 읽는 판
236:
237:> 이 파일은 `watchdog.py` 가 `state.json` 에서 자동으로 만듭니다.
238:> 손으로 고치지 마십시오. 고치려면 `state.json` 을 고치십시오.
