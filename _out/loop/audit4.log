301:        now=dt.datetime.now().strftime("%Y-%m-%d %H:%M"),
302:        branch=stage.get("branch"), sname=stage.get("name"),
303:        phase=stage.get("phase"), note=stage.get("note") or "",
304:        running=running,
305:        halt=state.get("halt_reason") or "없음",
