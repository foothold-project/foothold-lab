165:def find_mismatch(state: dict, big: list) -> list[str]:
166:    """상태 파일이 실제와 어긋나는 곳. **고치지 않고 적기만 한다.**"""
167:    out = []
168:    declared = state.get("running") or []
169:
170:    # **PID 마다 따로 본다.** 2026-09-23 에 여기서 한 번 놓쳤다.
171:    # 예전 판은 「선언은 있는데 큰 python 이 «하나도» 없다」만 봤다.
172:    # 둘을 걸고 하나가 죽으면 나머지 하나가 남아서 그물을 빠져나갔다.
173:    # 실제로 v2b-s 가 죽고 18 분을 조용히 지나갔다.
174:    live = set(p for p, _ in big)
175:    for run in declared:
176:        pid = run.get("pid")
177:        if pid and int(pid) not in live:
178:            out.append("«%s» (PID %s) 이 «죽었다». 자동으로 다시 걸지 «않는다». "
179:                       "로그를 보고 사람이 정한다: %s"
180:                       % (run.get("name"), pid, run.get("log") or "로그 경로 없음"))
181:
182:    if declared and not big:
183:        out.append("상태 파일은 «학습 중» 인데 큰 python 프로세스가 «하나도» 없다")
184:    if len(declared) != len(big):
185:        out.append("선언 %d 개 · 실제 %d 개. 수가 다르다"
186:                   % (len(declared), len(big)))
187:    if not declared and big:
188:        out.append("상태 파일은 «없음» 인데 큰 python 프로세스가 %d 개 돈다"
189:                   % len(big))
190:
191:    # 진행이 «멎은» 것도 죽은 것이다. 프로세스는 살아 있는데 체크포인트가
192:    # 안 늘어나는 경우를 프로세스 확인만으로는 못 잡는다.
193:    for run in declared:
194:        stale = checkpoint_stale_minutes(run)
195:        if stale is not None and stale > 30:
196:            out.append("«%s» 의 마지막 체크포인트가 %d 분 전이다. 멎었을 수 있다"
197:                       % (run.get("name"), int(stale)))
198:
199:    now = dt.datetime.now()
200:    for run in declared:
201:        end = run.get("expected_end")
202:        if not end:
203:            continue
204:        try:
205:            when = dt.datetime.fromisoformat(end)
206:        except ValueError:
207:            out.append("«%s» 의 expected_end 를 못 읽는다: %r"
208:                       % (run.get("name"), end))
209:            continue
210:        over = (now - when.replace(tzinfo=None)).total_seconds() / 60.0
211:        budget = float(run.get("expected_minutes") or 0) * 0.5
212:        if over > max(budget, 15.0):
213:            out.append("«%s» 이 예상 종료를 %d 분 넘겼다"
214:                       % (run.get("name"), int(over)))
215:    return out
