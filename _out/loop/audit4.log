66:
67:def log(msg: str) -> None:
68:    line = "%s  %s\n" % (dt.datetime.now().strftime("%Y-%m-%d %H:%M:%S"), msg)
69:    with _log_lock:
70:        with io.open(LOG, "a", encoding="utf-8") as handle:
71:            handle.write(line)
72:        sys.stdout.write(line)
73:        sys.stdout.flush()
