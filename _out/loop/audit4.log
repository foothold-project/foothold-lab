361:def main() -> int:
362:    if not os.path.isfile(STATE):
363:        log("state.json 이 없다. 멈춘다")
364:        return 1
365:    with io.open(STATE, encoding="utf-8") as handle:
366:        state = json.load(handle)
367:
368:    gpu = read_gpu()
369:    big = read_big_python()
370:    mismatch = find_mismatch(state, big)
371:
372:    fresh = render(state, gpu, big, mismatch)
373:    old = ""
374:    if os.path.isfile(HUMAN):
375:        with io.open(HUMAN, encoding="utf-8") as handle:
376:            old = handle.read()
377:
378:    changed = strip_volatile(fresh) != strip_volatile(old)
379:    if changed:
380:        with io.open(HUMAN, "w", encoding="utf-8") as handle:
381:            handle.write(fresh)
382:
383:    stage = state.get("stage") or {}
384:    if stage.get("phase") in ("학습 중", "평가 중"):
385:        log("  " + launch_eval())
386:
387:    log("확인 · 단계 [%s] %s · 도는 것 %d · 어긋남 %d · %s"
388:        % (stage.get("branch"), stage.get("phase"),
389:           len(state.get("running") or []), len(mismatch),
390:           "STATE.md 다시 씀" if changed else "내용 그대로"))
391:    for m in mismatch:
392:        log("  어긋남 · " + m)
393:    return 0
394:
395:
396:if __name__ == "__main__":
397:    sys.exit(main())
