134:def checkpoint_stale_minutes(run: dict):
135:    """마지막 체크포인트가 몇 분 전인지. 못 찾으면 None.
136:
137:    **프로세스가 살아 있는 것과 진행하는 것은 다르다.** 물리 엔진이
138:    멎거나 교착에 걸리면 프로세스는 그대로 남는다.
139:    """
140:    pat = run.get("out_dir") or ""
141:    base, tail = os.path.split(pat)
142:    if not os.path.isdir(base):
143:        return None
144:    if "*" in tail:
145:        suffix = tail.lstrip("*")
146:        hits = sorted(n for n in os.listdir(base) if n.endswith(suffix))
147:        if not hits:
148:            return None
149:        base = os.path.join(base, hits[-1])
150:    newest = None
151:    try:
152:        for n in os.listdir(base):
153:            if not n.startswith("model_") or not n.endswith(".pt"):
154:                continue
155:            t = os.path.getmtime(os.path.join(base, n))
156:            if newest is None or t > newest:
157:                newest = t
158:    except OSError:
159:        return None
160:    if newest is None:
161:        return None
162:    return (dt.datetime.now().timestamp() - newest) / 60.0
