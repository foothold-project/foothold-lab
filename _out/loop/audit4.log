48:CKPTS = (1500, 2000, 2500, 3000)
49:
50:# 축 1 · 실행 기록에서 그대로 읽은 값. 속도마다 평가창이 다르다.
51:# 명령 거리 6 m 를 맞추려고 12 · 6 · 4 초다. 20 초는 인자 기본값이지 우리 값이 아니다.
52:AXIS1_SPEEDS = (
53:    ("0.5", "12.0"),
54:    ("1.0", "6.0"),
55:    ("1.5", "4.0"),
56:)
57:AXIS1_SETS = ("rough6", "unseen10")
58:AXIS1_DEVICE = "cuda:1"      # v2b 를 잰 장치
59:AXIS2_DEVICE = "cuda:0"
