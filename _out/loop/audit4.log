175:def run_job(job: dict) -> int:
176:    odir = os.path.join(REPO, job["out"].replace("/", os.sep))
177:    os.makedirs(odir, exist_ok=True)
178:
179:    argv = [PYTHON] + job["argv"]
180:    # 규칙 7 · 실행 명령을 결과 폴더에 «파일로» 남긴다.
181:    # 무엇으로 돌렸는지가 사람 기억에만 있으면 재현을 못 한다.
182:    with io.open(os.path.join(odir, "command.txt"), "w", encoding="utf-8") as h:
183:        h.write(" ".join('"%s"' % a if " " in a else a for a in argv) + "\n")
184:        h.write("# 걸린 때 %s\n" % dt.datetime.now().isoformat(timespec="seconds"))
185:        h.write("# 건 것 _out/loop/eval_runner.py\n")
186:
187:    env = dict(os.environ)
188:    env["OMNI_KIT_ACCEPT_EULA"] = "YES"
189:    logfile = os.path.join(odir, "run.log")
190:    started = dt.datetime.now()
191:    with io.open(logfile, "w", encoding="utf-8", errors="replace") as h:
192:        proc = subprocess.Popen(argv, cwd=REPO, env=env,
193:                                stdout=h, stderr=subprocess.STDOUT)
194:        code = proc.wait()
195:    mins = (dt.datetime.now() - started).total_seconds() / 60
196:    ok = code == 0 and os.path.isfile(os.path.join(REPO, job["done_marker"]))
197:    log("  %s 축%d %s · %.1f 분 · exit=%d · %s"
198:        % (job["tag"], job["axis"], job["device"], mins, code,
199:           "산출물 있음" if ok else "«산출물 없음»"))
200:    return 0 if ok else 1
201:
202:
203:def worker(device: str, queue: list, results: dict) -> None:
204:    for job in queue:
205:        results[job["out"]] = run_job(job)
