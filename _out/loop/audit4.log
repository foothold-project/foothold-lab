330:def strip_volatile(text: str) -> str:
331:    """매번 흔들리는 값을 «뭉개서» 비교용 본문을 만든다.
332:
333:    왜 필요한가
334:        이것이 없으면 10 분마다 시각과 GPU 사용률만 바뀐 파일이 다시 쓰여
335:        `git status` 가 늘 더럽다. 진짜 변경이 그 잡음에 묻힌다.
336:
337:    왜 «지우지» 않고 «뭉개는가»
338:        지우면 GPU 가 0 MiB 에서 12 GB 로 올라가도 파일이 안 바뀐다.
339:        그러면 STATE.md 가 거짓말을 한다. 그래서 잡음만 없애고
340:        «비었다 / 쓰는 중» 같은 상태 전이는 그대로 남긴다.
341:    """
342:    keep = []
343:    for line in text.splitlines():
344:        s = line.strip()
345:        if s.startswith("**이 내용이 된 때**"):
346:            continue
347:        m = GPU_ROW.match(s)
348:        if m:
349:            used = int(m.group(3))
350:            keep.append("GPU%s %s" % (
351:                m.group(1), "비었음" if used < GPU_IDLE_MIB else "쓰는중"))
352:            continue
353:        m = PID_ROW.match(s)
354:        if m:
355:            keep.append("PID%s %.0fGB" % (m.group(1), float(m.group(2))))
356:            continue
357:        keep.append(line)
358:    return "\n".join(keep)
