# wt_guard 기본 설정 (D138 · RULES-HUB 2절). KEY=VALUE 한 줄씩. '#' 줄은 주석.
# 우선순위: 환경 변수 > 사용자 파일(~/.mai/wt_guard.env 또는 $MAI_WT_GUARD_CONFIG) > 이 파일 > 내장값.
# OS 별 값은 _WINDOWS · _LINUX 꼬리로 적고, 꼬리 없는 키(예: MAI_WT_ROOT)가 있으면 그것이 둘 다 이긴다.

# 작업 사본이 있어야 하는 뿌리 (새 사본은 <뿌리>/<저장소>/<이름>)
MAI_WT_ROOT_WINDOWS=D:/mai-wt
MAI_WT_ROOT_LINUX=/data/mai-wt

# 임시 · 산출 뿌리 (pytest --basetemp · TMP · TEMP · 평가 · 영상)
MAI_TMP_ROOT_WINDOWS=D:/mai-tmp
MAI_TMP_ROOT_LINUX=/data/mai-tmp

# 훅 경보 파일 자리 (쓸 수 없으면 ~/.mai/wt_guard/alerts 로 물러남)
MAI_WT_ALERT_DIR_WINDOWS=D:/mai-tmp/wt_guard/alerts
MAI_WT_ALERT_DIR_LINUX=/data/mai-tmp/wt_guard/alerts

# inventory 가 훑는 뿌리들 (';' 로 나눔)
MAI_WT_SCAN_ROOTS_WINDOWS=D:/mai-wt;C:/mai/wt
MAI_WT_SCAN_ROOTS_LINUX=/data/mai-wt

# disk_guard 가 보는 경로와 문턱 (GB = 10^9 바이트)
MAI_DISK_PATHS_WINDOWS=C:/;D:/
MAI_DISK_PATHS_LINUX=/;/data
MAI_DISK_WARN_GB=100
MAI_DISK_BLOCK_GB=50

# inventory 분류: 보관 후보 = 깨끗 · push 됨 · 이 날수 동안 안 쓴 사본. 「C 쪽 새 사본」 = 뿌리 밖 · 이 시각 뒤 생김
MAI_WT_IDLE_DAYS=7
MAI_WT_NEW_SINCE=2026-11-02T17:00:00+09:00

# 훅이 lead 에 알리는 orchestration 주소 (0 이면 안 알림)
MAI_WT_NOTIFY=1
MAI_WT_NOTIFY_RUN=run_abb2e12cee32
MAI_WT_NOTIFY_TO=run:run_abb2e12cee32
